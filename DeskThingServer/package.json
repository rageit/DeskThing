{
  "name": "deskthing",
  "version": "0.11.17",
  "description": "A DeskThing server UI to interface with the DeskThing car thing app",
  "main": "./out/main/index.js",
  "author": "Riprod",
  "type": "module",
  "homepage": "https://github.com/ItsRiprod/DeskThing",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "debug": "electron-vite dev --inspect=8893",
    "build": "node electron-builder.env.js && npm run typecheck && electron-vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps && electron-rebuild && npm rebuild sharp",
    "build:unpack": "npm run build && electron-builder --dir",
    "test": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/itsriprod/DeskThing.git"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "adm-zip": "^0.5.16",
    "auto-launch": "^5.0.6",
    "cors": "^2.8.6",
    "dompurify": "^3.3.3",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.8.3",
    "express": "^4.22.1",
    "flashthing": "^0.1.5",
    "lottie-react": "^2.4.1",
    "react-qr-code": "^2.0.18",
    "react-rewards": "^2.1.0",
    "react-router-dom": "^6.30.3",
    "react-select": "^5.10.2",
    "react-tag-input": "^6.10.6",
    "semver": "^7.7.4",
    "sharp": "^0.34.5",
    "uuid": "^10.0.0",
    "ws": "^8.19.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@deskthing/types": "^0.11.18",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.4",
    "@types/adm-zip": "^0.5.8",
    "@types/auto-launch": "^5.0.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^18.19.130",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.4",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typedoc": "^0.27.9",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.deskthing.app",
    "productName": "DeskThing",
    "directories": {
      "buildResources": "build"
    },
    "afterSign": "build/notarize.js",
    "files": [
      "!**/.vscode/*",
      "!src/*",
      "!electron.vite.config.{js,ts,mjs,cjs}",
      "!{.eslintignore,.eslintrc.cjs,.prettierignore,.prettierrc.yaml,dev-app-update.yml,CHANGELOG.md,README.md}",
      "!{.env,.npmrc,pnpm-lock.yaml}",
      "!{tsconfig.json,tsconfig.node.json,tsconfig.web.json}"
    ],
    "extraResources": [
      {
        "from": "src/main/config.json",
        "to": "config.json"
      }
    ],
    "asarUnpack": [
      "resources/**",
      "bin/**",
      "!resources/{,/**/}*.{h,hpp,cpp,cc,cxx}",
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ],
    "protocols": [
      {
        "name": "DeskThing Protocol",
        "schemes": [
          "deskthing"
        ]
      }
    ],
    "win": {
      "verifyUpdateCodeSignature": false,
      "executableName": "DeskThing",
      "artifactName": "${name}-${os}-${version}-setup.${ext}",
      "publisherName": "Riprod",
      "extraFiles": [
        {
          "from": "adb_source/win",
          "to": "resources/win"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "${name}-${os}-${version}-setup.${ext}",
      "shortcutName": "${productName}",
      "uninstallDisplayName": "${productName}",
      "createDesktopShortcut": "always",
      "deleteAppDataOnUninstall": true,
      "perMachine": false,
      "allowElevation": true
    },
    "mac": {
      "gatekeeperAssess": false,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "This app requires access to send Apple Events to communicate with other applications.",
        "NSMicrophoneUsageDescription": "This app requires microphone access to record audio."
      },
      "notarize": false,
      "category": "public.app-category.developer-tools",
      "extraFiles": [
        {
          "from": "adb_source/mac",
          "to": "resources/mac"
        }
      ]
    },
    "dmg": {
      "sign": false,
      "artifactName": "${name}-${os}-${arch}-${version}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Riprod",
      "category": "Utility",
      "extraFiles": [
        {
          "from": "adb_source/linux",
          "to": "resources/linux"
        }
      ]
    },
    "appImage": {
      "artifactName": "${name}-${os}-${version}-setup.${ext}"
    },
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "ItsRiprod",
      "repo": "DeskThing",
      "releaseType": "release"
    }
  },
  "electronDownload": {
    "mirror": "https://npmmirror.com/mirrors/electron/"
  }
}
